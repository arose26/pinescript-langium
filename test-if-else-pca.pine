// Test file for if-else structure from PCA.pine

haCountMethod(length) =>
    haclose = 100
    haopen = 90
    hac = 50.0
    if barstate.isfirst
        hac := 50
    else if haclose > haopen
        hac := hac[1] / length + (100 * ((length - 1)/length))
    else if haclose < haopen
        hac := hac[1] / length
    else
        hac := hac[1]
    hac

// Test usage
var result = haCountMethod(10)
