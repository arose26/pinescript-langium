//@version=5
indicator("Function with If Block", overlay=false)

// Function with if statement in a block
f(x=10) => 
    if x > 5
        x * 2
    else
        x

// Use the function
y = f(3)
z = f(10)

// Plot the results
plot(y, "Result Y", color=color.blue)
plot(z, "Result Z", color=color.red)
