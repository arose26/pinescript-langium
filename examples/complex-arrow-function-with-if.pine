//@version=5
indicator("Complex Arrow Function with If", overlay=false)

// Arrow function with complex parameters and if statement
isInBullDivergence(indicator, price=close, length=100, confirm=true, confLength=1) =>
    isDiv = 0
    confirmOffset = confirm ? confLength : 0
    LL = indicator[0+confirmOffset]
    if (indicator < 50)
        isDiv := 1
    isDiv

// Use the function
result = isInBullDivergence(close, length=50)

// Plot the result
plot(result, "Result", color=color.blue)
