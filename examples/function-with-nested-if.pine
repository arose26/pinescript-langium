//@version=5
indicator("Function with Nested If", overlay=false)

// Function with nested if statements
f(x=10, y=5) => 
    result = 0
    if x > 5
        if y > 3
            result := x * y
        else
            result := x + y
    else
        result := x - y
    result

// Use the function
a = f(10, 5)
b = f(10, 2)
c = f(3, 5)

// Plot the results
plot(a, "Result A", color=color.blue)
plot(b, "Result B", color=color.red)
plot(c, "Result C", color=color.green)
