//@version=5
indicator("Arrow Function with If", overlay=false)

// Arrow function with if statement
f(x=10) =>
    result = 0
    if x > 5
        result := x * 2
    else
        result := x
    result

// Use the function
y = f(3)
z = f(10)

// Plot the results
plot(y, "Result Y", color=color.blue)
plot(z, "Result Z", color=color.red)
