//@version=5
indicator("Deeply Nested If Statements", overlay=false)

// Function with deeply nested if statements
complexCondition(a=10, b=5, c=3, d=1) => 
    result = 0
    
    if a > 5
        if b > 3
            if c > 2
                if d > 0
                    result := a * b * c * d
                else
                    result := a * b * c
            else
                if d > 0
                    result := a * b + d
                else
                    result := a * b
        else
            if c > 2
                result := a + c
            else
                result := a
    else
        if b > 3
            result := b
        else
            result := 0
    
    result

// Use the function with different combinations
r1 = complexCondition(10, 5, 3, 1)  // All conditions true
r2 = complexCondition(10, 5, 3, 0)  // First three true, last false
r3 = complexCondition(10, 5, 1, 1)  // First two true, third false, fourth true
r4 = complexCondition(10, 2, 3, 1)  // First and third true, second false
r5 = complexCondition(3, 5, 3, 1)   // First false, rest true

// Plot the results
plot(r1, "All True", color=color.green)
plot(r2, "Three True", color=color.blue)
plot(r3, "Mixed 1", color=color.red)
plot(r4, "Mixed 2", color=color.yellow)
plot(r5, "First False", color=color.purple)
