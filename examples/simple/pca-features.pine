// Test file for PCA features

// Array destructuring assignment
[middle, upper, lower] = ta.bb(close, 20, 2)

// Variable reassignment with := operator
stc := math.max(math.min(stc, 100), 0)

// Ternary operator in complex expressions
upper = ta.ema(ta.change(close) <= 0 ? 0 : stddev, 14)

// Request.security and ticker functions
[haclose, haopen] = request.security(ticker.heikinashi(syminfo.tickerid), '', [close, open])

// Input functions with named parameters
source = input.source(defval=close, title="Source", group="General Settings")

// Complex for loop with dynamic conditions
isDiv = 0
confirmOffset = true ? 1 : 0
LL = indicator[0+confirmOffset]
if (isPL(indicator, right=confirmOffset) and indicator < 50)
    for i = 1+confirmOffset to 100+confirmOffset
        if (LL > indicator[i] and indicator[i] < indicator[i+1])
            LL := indicator[i]
            if (price[i] > price[confirmOffset] and ta.lowestbars(price, i) < 3)
                isDiv := i
