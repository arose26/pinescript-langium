{
    "name": "pinescript-langium",
    "version": "0.1.0",
    "description": "PineScript grammar in Langium format",
    "main": "out/extension.js",
    "scripts": {
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "build": "tsc -b tsconfig.json",
        "watch": "tsc -b tsconfig.json --watch"
    },
    "dependencies": {
        "chevrotain": "^9.1.0",
        "langium": "^1.0.0",
        "vscode-languageserver": "^8.0.2",
        "vscode-uri": "^3.0.2"
    },
    "devDependencies": {
        "langium-cli": "^1.0.0",
        "typescript": "^4.9.4"
    }
}
