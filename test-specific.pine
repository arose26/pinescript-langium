// Test file for specific constructs

// Test function with default parameters
testFunc(a, b=10, c=20) =>
    a + b + c

// Test function with array return
testArray() =>
    [1, 2, 3]

// Test function with ternary expression
testTernary(a, b) =>
    a > b ? a : b

// Test function with if-else
testIfElse(a, b) =>
    if a > b
        a + b
    else if a == b
        a * b
    else
        a - b

// Test function with inline if-else
testInlineIfElse(a, b) =>
    if a > b
        a + b
    else if a < b
        a - b
    else
        a * b

// Test usage
var result1 = testFunc(5)
var result2 = testArray()
var result3 = testTernary(10, 20)
var result4 = testIfElse(10, 20)
var result5 = testInlineIfElse(10, 20)
