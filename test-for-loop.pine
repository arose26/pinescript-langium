// Test file for for loops

// Simple for loop
testForLoop() =>
    sum = 0
    for i = 1 to 10
        sum := sum + i
    sum

// For loop with step
testForLoopStep() =>
    sum = 0
    for i = 1 to 10 by 2
        sum := sum + i
    sum

// For loop with array
testForLoopArray() =>
    arr = [1, 2, 3, 4, 5]
    sum = 0
    for i = 0 to 4
        sum := sum + arr[i]
    sum

// Test usage
var result1 = testForLoop()
var result2 = testForLoopStep()
var result3 = testForLoopArray()
