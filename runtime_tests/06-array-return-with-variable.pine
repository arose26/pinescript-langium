//@version=5
indicator("Array Return With Variable Test")

// Create a function that returns an array with two elements
get_values() =>
    x = 15
    y = 25
    [x, y]

// Call the function and destructure the result
[a, b] = get_values()

// Plot the values
plot(a, "First Value", color=color.blue)
plot(b, "Second Value", color=color.green)
