//@version=5
indicator("Array Set Test")

// Create a new array with 5 elements, initialized to 0
arr = array.new_int(5)

// Set values at specific indices
array.set(arr, 0, 10)
array.set(arr, 1, 20)
array.set(arr, 2, 30)
array.set(arr, 3, 40)
array.set(arr, 4, 50)

// Plot some values
plot(arr[0], "Array Element 0", color=color.blue)
plot(arr[2], "Array Element 2", color=color.green)
plot(arr[4], "Array Element 4", color=color.red)
