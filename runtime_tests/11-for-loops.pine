//@version=5
indicator("For Loops Test")

// Simple for loop
sum1 = 0
for i = 1 to 5
    sum1 := sum1 + i

// For loop with step
sum2 = 0
for j = 0 to 10 by 2
    sum2 := sum2 + j

// For loop with variable bounds
start = 1
end = 5
sum3 = 0
for k = start to end
    sum3 := sum3 + k

// Plot the results
plot(sum1, "Sum 1 to 5", color=color.blue)
plot(sum2, "Sum Even 0 to 10", color=color.red)
plot(sum3, "Sum Variable Bounds", color=color.green)
