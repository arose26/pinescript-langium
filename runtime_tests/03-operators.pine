//@version=5
indicator("Operators Test")

// Arithmetic operators
a = 10
b = 5
add_result = a + b    // 15
sub_result = a - b    // 5
mul_result = a * b    // 50
div_result = a / b    // 2
mod_result = a % b    // 0

// Comparison operators
greater = a > b       // true
less = a < b          // false
equal = a == b        // false
not_equal = a != b    // true
greater_equal = a >= b // true
less_equal = a <= b   // false

// Logical operators
and_result = true and true   // true
or_result = true or false    // true
not_result = not true        // false

// Conditional operator (ternary)
condition = close > open
ternary_result = condition ? 1 : -1

// Plot the results
plot(add_result, "Addition", color=color.blue)
plot(sub_result, "Subtraction", color=color.red)
plot(ternary_result, "Ternary", color=condition ? color.green : color.red)
