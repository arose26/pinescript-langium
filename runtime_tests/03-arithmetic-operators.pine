//@version=5
indicator("Arithmetic Operators Test")

// Arithmetic operators
a = 10
b = 5
add_result = a + b    // 15
sub_result = a - b    // 5
mul_result = a * b    // 50
div_result = a / b    // 2
mod_result = a % b    // 0

// Plot the results
plot(add_result, "Addition", color=color.blue)
plot(sub_result, "Subtraction", color=color.red)
