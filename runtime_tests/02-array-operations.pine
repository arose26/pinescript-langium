//@version=5
indicator("Array Operations Test")

// Create an array
arr = [10, 20, 30, 40, 50]

// Access elements
first = arr[0]    // 10
third = arr[2]    // 30
last = arr[4]     // 50

// Calculate sum
sum = first + third + last  // 10 + 30 + 50 = 90

// Plot the results
plot(sum, "Sum", color=color.blue)
