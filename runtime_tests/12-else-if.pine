//@version=5
indicator("Else-If Statements Test")

// Simple else-if statement
value = 2
result = "unknown"

if value == 1
    result := "one"
else if value == 2
    result := "two"
else if value == 3
    result := "three"
else
    result := "other"

// Nested else-if statement
value2 = 5
category = "unknown"

if value2 < 0
    category := "negative"
else if value2 == 0
    category := "zero"
else
    if value2 < 5
        category := "small positive"
    else if value2 < 10
        category := "medium positive"
    else
        category := "large positive"

// Plot the results
plot(1, "Result: " + result, color=color.blue)
plot(2, "Category: " + category, color=color.red)
