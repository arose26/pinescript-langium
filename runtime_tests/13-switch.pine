//@version=5
indicator("Switch Statements Test")

// Simple switch statement
value = 2
result = "unknown"

result := switch value
    1 => "one"
    2 => "two"
    3 => "three"
    => "other"  // default case

// Switch with expressions
score = 85
grade = "unknown"

grade := switch
    score >= 90 => "A"
    score >= 80 => "B"
    score >= 70 => "C"
    score >= 60 => "D"
    => "F"  // default case

// Switch with variable assignment
dayNumber = 3
dayName = "unknown"
isWeekend = false

[dayName, isWeekend] := switch dayNumber
    1 => ["Monday", false]
    2 => ["Tuesday", false]
    3 => ["Wednesday", false]
    4 => ["Thursday", false]
    5 => ["Friday", false]
    6 => ["Saturday", true]
    7 => ["Sunday", true]
    => ["Invalid day", false]  // default case

// Plot the results
plot(1, "Result: " + result, color=color.blue)
plot(2, "Grade: " + grade, color=color.red)
plot(3, "Day: " + dayName + (isWeekend ? " (weekend)" : ""), color=color.green)
