//@version=5
indicator("Variables and Data Types")

// Basic variable declarations
a = 5
b = 3.14
c = true
d = "Hello"
e = color.red

// Built-in variables
current_close = close
current_high = high
current_low = low
current_open = open

// Plot the values
plot(a, "Integer", color=color.blue)
plot(b, "Float", color=color.green)
plot(current_close, "Close", color=color.red)
