//@version=5
indicator("Simple Array Sum Test")

// Create a function that performs some operations and returns an array
create_array() =>
    base = [1, 2, 3, 4, 5]
    sum = 0
    for i = 0 to array.size(base) - 1
        sum := sum + base[i]
    
    sum

// Call the function and plot the result
total_sum = create_array()

// Plot the values
plot(total_sum, "Sum of Array", color=color.blue)
