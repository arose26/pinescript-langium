//@version=5
indicator("Complex Array Operations Test")

// Create a complex array with different operations
create_array() =>
    base = [1, 2, 3, 4, 5]
    // Perform operations on the array
    sum = 0
    for i = 0 to array.size(base) - 1
        sum := sum + base[i]
    
    // Create a new array with transformed values
    transformed = array.new_int(array.size(base))
    for i = 0 to array.size(base) - 1
        array.set(transformed, i, base[i] * 2)
    
    // Return multiple values
    [sum, transformed]

// Call the function and destructure the result
[total_sum, doubled_array] = create_array()

// Access and plot values
plot(total_sum, "Sum of Array", color=color.blue)
plot(doubled_array[2], "Doubled value at index 2", color=color.green)
