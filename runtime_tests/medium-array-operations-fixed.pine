//@version=5
indicator("Medium Array Operations Test")

// Create a function that performs some operations and returns an array
create_array() =>
    base = [1, 2, 3, 4, 5]
    sum = 0
    for i = 0 to array.size(base) - 1
        sum := sum + base[i]
    
    [sum, base[2]]

// Call the function and destructure the result
[total_sum, middle_value] = create_array()

// Plot the values
plot(total_sum, "Sum of Array", color=color.blue)
plot(middle_value, "Middle Value", color=color.green)
