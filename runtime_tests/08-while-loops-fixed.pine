//@version=5
indicator("While Loops Test")

// Simple while loop
counter = 0
sum = 0
while counter < 10
    sum := sum + counter
    counter := counter + 1

// While loop with break
counter2 = 0
sum2 = 0
while true
    sum2 := sum2 + counter2
    counter2 := counter2 + 1
    if counter2 >= 5
        break

// While loop with continue
counter3 = 0
sum3 = 0
while counter3 < 10
    counter3 := counter3 + 1
    if counter3 % 2 == 0  // Skip even numbers
        continue
    sum3 := sum3 + counter3

// Plot the results
plot(sum, "Sum 1-9", color=color.blue)
plot(sum2, "Sum 0-4", color=color.red)
plot(sum3, "Sum of odd numbers 1-9", color=color.green)
