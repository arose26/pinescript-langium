// Simplified version of PCA.pine
var source = close

// Simple function with ternary
test(a, b) =>
    a > b ? a : b

// Function with array return
getArray() =>
    [1, 2, 3]

// Function with if-else
testIfElse(a, b) =>
    if a > b
        a + b
    else if a == b
        a * b
    else
        a - b

var result = test(10, 20)
var arr = getArray()
var ifResult = testIfElse(10, 20)
