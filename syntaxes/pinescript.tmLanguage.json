{
  "name": "pinescript",
  "scopeName": "source.pinescript",
  "fileTypes": [
    ".pine"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.pinescript",
      "match": "\\b(and|as|break|by|const|continue|else|export|false|for|if|import|in|input|method|not|or|series|simple|switch|to|true|type|var|varip|while)\\b"
    },
    {
      "name": "string.quoted.double.pinescript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.pinescript",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.pinescript"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.pinescript"
        },
        {
          "name": "comment.block.pinescript",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pinescript"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pinescript"
            }
          }
        },
        {
          "name": "comment.block.pinescript",
          "begin": "",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pinescript"
            }
          },
          "end": "\n",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pinescript"
            }
          }
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.pinescript",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
