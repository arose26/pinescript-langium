// Test file for specific issues in PCA.pine

// Test if-else without parentheses
testIfElse(a, b) =>
    if a > b
        a + b
    else if a < b
        a - b
    else
        a * b

// Test array subscript
testArraySubscript() =>
    arr = [1, 2, 3]
    arr[0]

// Test array return
testArrayReturn() =>
    [1, 2, 3]

// Test usage
var result1 = testIfElse(10, 20)
var result2 = testArraySubscript()
var result3 = testArrayReturn()
