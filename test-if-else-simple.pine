// Test file for if-else structure

// Simple if-else without parentheses
testIfElseSimple(a, b) =>
    if a > b
        a + b
    else if a < b
        a - b
    else
        a * b

// Test if-else with parentheses
testIfElseParens(a, b) =>
    if (a > b)
        a + b
    else if (a < b)
        a - b
    else
        a * b

// Test usage
var result1 = testIfElseSimple(10, 20)
var result2 = testIfElseParens(10, 20)
